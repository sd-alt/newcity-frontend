{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "rules": {
    "typescript/no-unused-vars": "warn",
    "import/no-duplicates": "warn"
  },
  "overrides": [
    {
      "files": ["*.vue"],
      "rules": {
        "typescript/no-unused-vars": "off"
      }
    }
  ]
}
